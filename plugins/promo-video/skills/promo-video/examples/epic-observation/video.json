{
  "title": "Epic Observation — feature promo",
  "lang": "en",
  "targets": [
    {"platform": "telegram", "format": "9:16"},
    {"platform": "instagram", "format": "9:16"}
  ],
  "voice": {"voice": "Daniel", "models": ["eleven_v4", "eleven_multilingual_v2"], "stability": 0.4},
  "theme": {"preset": "dark"},
  "captures": [
    {"name": "replay", "url": "page.html", "viewport": [540, 960], "scale": 2,
     "sequence": {"count": "+document.getElementById('slider').max + 1",
                  "eval": "(() => { const s = document.getElementById('slider'); s.value = {i}; s.dispatchEvent(new Event('input')); })()"}},
    {"name": "full", "url": "page.html", "viewport": [540, 960], "scale": 2, "full_page": true,
     "measure": {"log_top": "document.getElementById('log').closest('section').getBoundingClientRect().top + scrollY"}},
    {"name": "burn", "url": "page.html", "viewport": [720, 1400], "scale": 3, "steps": [{"check": "#fcToggle"}], "selector": "#burn"},
    {"name": "cascade", "url": "page.html", "viewport": [1000, 1400], "scale": 2.5,
     "steps": [{"scroll": "#cascadeWrap"}, {"hover": "#cascadeWrap :text('SHOP-104')"}], "selector": "#cascadeWrap"},
    {"name": "prs", "url": "page.html", "viewport": [520, 1400], "scale": 3, "selector": "section:has(#prs)"},
    {"name": "matrix", "url": "page.html", "viewport": [520, 1400], "scale": 3, "selector": "#matrixCard"}
  ],
  "scenes": [
    {"id": "hook", "type": "reveal",
     "say": "Your epic lives in Jira... or Linear, or Monday, or GitHub. And somehow, everyone keeps asking the same thing: so, where are we?",
     "lead": "Your epic lives in",
     "items": [{"text": "Jira", "at": "Jira"}, {"text": "Linear", "at": "Linear"},
               {"text": "monday.com", "at": "Monday"}, {"text": "GitHub", "at": "GitHub"}],
     "punch": {"text": "Where are we?", "at": "where"}},
    {"id": "intro", "type": "title", "say": "Meet Epic Observation, a new plugin for Claude Code.",
     "kicker": "New · Claude Code plugin", "lines": ["Epic", "Observation"],
     "media": {"image": "@replay_12", "width": 700}},
    {"id": "replay", "type": "screen",
     "say": "It turns any epic into a live page. Hit play, and watch its whole history unfold: every status change, every review, every merge.",
     "frames": "@replay", "sequence": {"from": "play"}, "tap": {"x": 222, "y": 1427, "at": "play"}},
    {"id": "burn", "type": "spotlight", "say": "A burn-up, with an honest forecast.",
     "kicker": "Burn-up", "title": "Honest forecast", "sub": "optimistic · expected · pessimistic",
     "image": "@burn", "fit": 480, "pan": [0.3, 1]},
    {"id": "cascade", "type": "spotlight", "say": "A dependency cascade, straight from your tracker's blocked-by links.",
     "kicker": "Cascade", "title": "Dependencies", "sub": "straight from blocked-by links",
     "image": "@cascade", "fit": 1100},
    {"id": "changes", "type": "cards", "say": "Pull requests and test evidence, side by side.",
     "kicker": "Changes & evidence", "title": "Side by side", "images": ["@prs", "@matrix"]},
    {"id": "log", "type": "screen", "say": "And an event log that links back to every source.",
     "image": "@full", "scroll": [{"measure": "full.log_top", "scale": 2, "offset": -60},
                                  {"measure": "full.log_top", "scale": 2, "offset": 840}]},
    {"id": "neutral", "type": "mapping",
     "say": "One small profile maps your tool onto a neutral model, so every page looks the same, no matter which tracker sits behind it.",
     "kicker": "Bring your own tracker", "title": "One neutral model",
     "rows": [{"tag": "Jira", "left": "Code Review", "right": "in_review"},
              {"tag": "Linear", "left": "Todo", "right": "ready"},
              {"tag": "monday.com", "left": "Working on it", "right": "in_progress"},
              {"tag": "GitHub", "left": "closed (not planned)", "right": "canceled"}],
     "media": {"image": "@replay_12", "at": "so"}},
    {"id": "cta", "type": "title", "say": "Epic Observation. Two commands, and it's yours.",
     "lines": ["Epic", "Observation"], "sub": "Live epic timeline for any tracker",
     "code": {"lines": ["/plugin marketplace add sergio-bershadsky/ai",
                        "/plugin install epic-observation@bershadsky-claude-tools"], "at": "Two"},
     "footer": {"lines": ["github.com/sergio-bershadsky/ai", "Linear · Jira · monday.com · GitHub · …"], "at": "yours"}}
  ]
}
